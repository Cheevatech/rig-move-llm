# built binaries (root-level output only; not cmd/rig-move-llm/ source)
/rig-move-llm
/dist/
*.exe

# npm release artifacts (generated by scripts/prepare-npm.mjs in CI)
npm/platforms/
npm/node_modules/
npm/dist/

# local config (secrets: endpoint keys)
config.env
user.env
.rig-move-llm/

# logs / runtime
*.log

# local dev/eval harness (points at our violin — never publish)
.dev/

# generated by prepare-npm.mjs
npm/LICENSE

# Python bytecode is never part of a change under review.
__pycache__/
*.pyc

# Claude Code's scratch worktrees. They are real git worktrees, so `git add -A`
# stages them as gitlinks (mode 160000) — committing that leaves every clone with
# broken submodule references pointing at commits nobody else has.
.claude/worktrees/
